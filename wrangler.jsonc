{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biddr-ai-copilot",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "BiddrCopilotAgent",
        "name": "BiddrCopilotAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["BiddrCopilotAgent"],
      "tag": "v1"
    }
  ],
  "observability": {
    "enabled": true
  }
}

